@model List<RedCross_System.ViewModel.User.UserIndexViewModel>

<div class="container" style="position: relative;">
  <div class="position-absolute" style="top: 10px; right: 10px;">
    <a asp-action="Index" asp-controller="Login" class="btn btn-link">
      Login
    </a>
  </div>
</div>
<div class="container mt-4">
  <h1 class="text-left text-primary mb-4">User </h1>
 
  <div class="d-flex justify-content-start mb-3">
    <a asp-action="Add" asp-controller="User" class="btn btn-primary" style="text-decoration: none;">
      <i class="fas fa-plus"></i>
      Add User
    </a>
  </div>
  <div class="card card-primary">
    <div class="card-header">
      <h3 class="card-title">User Information</h3>
    </div>
    <div class="card-body">
      <table class="table table-bordered table-hover table-striped">
        <thead class="thead-light">
          <tr>
            <th>SN</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          @{
            long sn = 1;
            foreach (var user in Model)
            {
              <tr>
                <td>@sn</td>
                <td>@user.Name</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>
                  <div class="d-flex gap-2">
                    <a asp-action="Update" asp-route-id="@user.Id" class="btn btn-success btn-sm">
                      <i class="fas fa-edit"></i> Update
                    </a>
                  </div>
                </td>
              </tr>
              sn++;
            }
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Include AdminLTE CSS and JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/css/adminlte.min.css">
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/js/adminlte.min.js"></script>

<style>
  /* Table Styling */
  .table th, .table td {
    text-align: center;
    vertical-align: middle;
  }

  /* Button Styling */
  .btn-sm {
    padding: 6px 12px;
    font-size: 14px;
  }

  .btn-success {
    background-color: #28a745;
    border-color: #28a745;
  }

    .btn-success:hover {
      background-color: #218838;
      border-color: #1e7e34;
    }

  /* Card Header Styling */
  .card-header {
    background-color: #003366;
    color: white;
  }

  .card-body {
    padding: 20px;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: bold;
  }

  /* Flexbox for action buttons */
  .d-flex {
    display: flex;
    gap: 10px;
  }

  /* Add some spacing for the table */
  .container {
    padding-top: 20px;
  }
</style>
