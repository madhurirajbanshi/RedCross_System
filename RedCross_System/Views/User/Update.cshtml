@model RedCross_System.ViewModel.User.UserUpdateViewModel

<div>

  <h1 style="text-align:center">Update User</h1>
  <form method="post" asp-action="Update" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="mb-2">
      <label for="" class="form-label">Name</label>
      <input type="text" class="form-control" asp-for="Name" />
    </div>
    <div class="mb-2">
      <label for="" class="form-label">Email</label>
      <input type="email" class="form-control" asp-for="Email" />
    </div>

    <div class="mb-2">
      <label for="" class="form-label">Password</label>
      <input type="password" class="form-control" asp-for="Password" />
    </div>


    <div class="mb-2">
      <label for="Role" class="form-label">Select Role</label>
      <select class="form-control" asp-for="Role" asp-items="@Model.Roles">
        <option value="">-- Select Role --</option>
      </select>
    </div>
    <div class="mb-2">
      <label for="Bloodtype" class="form-label">Blood Type</label>
      <select class="form-control" asp-for="BloodType" asp-items="@Model.BloodTypes">
        <option value="">-- Select BloodType--</option>
      </select>
    </div>

    <div class="text-center">
      <button type="submit" class="btn btn-primary">Submit</button>
    </div>
  </form>

  <style>
    form {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      background-color: #f9f9f9;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

      form h1 {
        text-align: center;
        margin-bottom: 20px;
        font-size: 24px;
        color: #333;
      }

    label.form-label {
      font-weight: 600;
      color: #555;
      margin-bottom: 8px;
      display: block;
    }

    input.form-control {
      width: 100%;
      padding: 10px;
      margin: 8px 0;
      border: 1px solid #ccc;
      border-radius: 4px;
      box-sizing: border-box;
    }

      input.form-control:focus {
        outline: none;
        border-color: #007bff;
        box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
      }

    button.btn {
      background-color: green;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 4px;
      font-size: 16px;
      cursor: pointer;
      transition: background-color 0.3s;
      display: flex;
      justify-content: center;
      align-items: center;
    }

      button.btn:hover {
        background-color: #0056b3;
      }

    .mb-2 {
      margin-bottom: 1rem;
    }

    input[type="file"] {
      padding: 5px;
      margin-top: 8px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }

      input[type="file"]:focus {
        border-color: #007bff;
        box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
      }

    .text-center {
      text-align: center;
      .text-center

    {
      text-align: center;
    }

    button.btn {
      display: block;
      margin: 0 auto;
    }

    }
  </style>
</div>


