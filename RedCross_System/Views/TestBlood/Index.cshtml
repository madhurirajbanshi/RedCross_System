@model List<RedCross_System.ViewModel.TestBlood.TestBloodIndexViewModel>

<div class="container mt-4">
  <h1 class="text-left text-primary mb-4">TestBlood List</h1>
  

  <p>
    <a href="@Url.Action("Add", "TestBlood")" class="btn btn-primary" style="text-decoration: none;">
      <i class="fas fa-plus"></i>Add New Test Blood
    </a>
  </p>
  <div class="card card-primary">
    <div class="card-header">
      <h3 class="card-title">TestBlood Information</h3>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-bordered table-hover table-striped">
          <thead class="thead-light">
            <tr>
              <th>SN</th>
              <th>Test Name</th>
              <th>Donation</th>
              <th>Status</th>
              <th>Actions</th>

            </tr>
          </thead>
          <tbody>
            @{
              long sn = 1;
              foreach (var testBlood in Model)
              {
                <tr>
                  <td>@sn</td>
                  <td>@testBlood.TestName</td>

                  <td>@testBlood.Donation</td>
                  <td>
                    <span class="badge @(testBlood.Status == "Active" ? "bg-success" : "bg-danger")">
                      @testBlood.Status
                    </span>
                  </td>
                  <td>
                    <div class="d-flex gap-2">
                      <a asp-action="Update" asp-route-id="@testBlood.Id" class="btn btn-success btn-sm">
                        <i class="fas fa-edit"></i> Update
                      </a>
                      <a asp-action="Report" asp-route-id="@testBlood.Id" class="btn btn-info btn-sm">
                        <i class="fas fa-file-alt"></i> Report
                      </a>
                      <form asp-action="ToggleStatus" asp-route-id="@testBlood.Id" method="post">
                        <button type="submit" class="btn btn-status @(testBlood.Status == "Active" ? "btn-danger" : "btn-success")">
                          @(testBlood.Status == "Active" ? "Deactivate" : "Activate")
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
                sn++;
              }
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Include AdminLTE CSS and JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/css/adminlte.min.css">
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/js/adminlte.min.js"></script>

<style>
  /* Table Styling */
  .table th, .table td {
    text-align: center;
    vertical-align: middle;
  }

  /* Button Styling */
  .btn-sm {
    padding: 6px 12px;
    font-size: 14px;
  }

  .btn-success {
    background-color: #28a745;
    border-color: #28a745;
  }

    .btn-success:hover {
      background-color: #218838;
      border-color: #1e7e34;
    }

  /* Card Header Styling */
  .card-header {
    background-color: #003366;
    color: white;
  }

  .card-body {
    padding: 20px;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: bold;
  }

  /* Flexbox for action buttons */
  .d-flex {
    display: flex;
    gap: 10px;
  }

  /* Add some spacing for the table */
  .container {
    padding-top: 20px;
  }
</style>







