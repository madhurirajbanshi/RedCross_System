@model List<RedCross_System.ViewModel.Campaign.CampaignIndexViewModel>

<div class="container mt-4">
  <h1 class="text-left text-primary mb-4">Campaign</h1>
  <div class="d-flex justify-content-start mb-3">
    <a asp-action="Add" asp-controller="Campaign" class="btn btn-primary" style="text-decoration: none;">
      <i class="fas fa-plus"></i>
      Create Campaign
    </a>
  </div>
  <div class="card card-primary">
    <div class="card-header">
      <h3 class="card-title">Campaign Information</h3>
    </div>
    <div class="card-body">
      <table class="table table-bordered table-hover table-striped">
        <thead class="thead-light">
          <tr>
            <th>SN</th>
            <th>Name</th>
            <th>Address</th>
            <th>Branch Name</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>

            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          @{
            long sn = 1;
            foreach (var campaign in Model)
            {
              <tr>
                <td>@sn</td>
                <td>@campaign.Name</td>
                <td>@campaign.Address</td>
                <td>@campaign.Branch Name</td>

                <td>@campaign.StartDate.ToString("dd-MM-yyyy")</td>
                <td>@campaign.EndDate.ToString("dd-MM-yyyy")</td>

                <td>
                  <form asp-action="ToggleStatus" asp-route-id="@campaign.Id" method="post">
                    <button type="submit" class="btn btn-sm" style="background-color: @(campaign.Status == "Active" ? "#28a745" : "#dc3545");">
                      @(campaign.Status == "Active" ? "Active" : "Inactive")
                    </button>
                  </form>
                </td>
                <td>
                  <div class="d-flex gap-2">
                    <a asp-action="Update" asp-route-id="@campaign.Id" class="btn btn-success btn-sm">
                      <i class="fas fa-edit"></i> Update
                    </a>
                  </div>
                </td>
              </tr>
              sn++;
            }
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Include AdminLTE CSS and JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/css/adminlte.min.css">
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/js/adminlte.min.js"></script>

<style>
  /* Table Styling */
  .table th, .table td {
    text-align: center;
    vertical-align: middle;
  }

  /* Button Styling */
  .btn-sm {
    padding: 6px 12px;
    font-size: 14px;
  }

  .btn-success {
    background-color: #28a745;
    border-color: #28a745;
  }

    .btn-success:hover {
      background-color: #218838;
      border-color: #1e7e34;
    }

  /* Card Header Styling */
  .card-header {
    background-color: #003366;
    color: white;
  }

  .card-body {
    padding: 20px;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: bold;
  }

  /* Flexbox for action buttons */
  .d-flex {
    display: flex;
    gap: 10px;
  }

  /* Add some spacing for the table */
  .container {
    padding-top: 20px;
  }
</style>

