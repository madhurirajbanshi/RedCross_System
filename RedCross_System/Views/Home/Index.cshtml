@model List<RedCross_System.Models.ControllerInfo>

<div class="container mt-4">
  <h1 class="text-danger mb-4">Red Cross System</h1>

  <div class="row">
    @foreach (var controller in Model)
    {
      <div class="col-md-4 mb-4">
        <div class="card text-white bg-danger shadow-lg h-100">
          <div>
          
            <span class="badge bg-light text-danger fw-bold position-absolute top-0 end-0 m-2"
                  style="font-size: 0.8rem; padding: 0.25em 0.5em;">@controller.Count</span>
         </div>


          <div class="card-body">
            <div class="d-flex align-items-center">
              <i class="controller-icon fa
                @(controller.Controller == "Campaign" ? "fa-bullhorn" :
                  controller.Controller == "Donor" ? "fa-hand-holding-heart" :
                  controller.Controller == "User" ? "fa-users" :
                  controller.Controller == "Donation" ? "fa-donate" :
                  controller.Controller == "Branch" ? "fa-building" :
                  controller.Controller == "TestBlood" ? "fa-tint" : "") fa-2x me-3"></i>
              <div>
              <h5 class="card-title mt-0" style="font-size: 1.5rem;">@controller.Name</h5>
              @* class="position-absolute top-0 start-0 m-2"> *@
              
              </div>
            </div>
          </div>
          <div class="card-footer text-center">
            <a href="@Url.Action("Index", controller.Controller)" class="btn btn-light text-danger fw-bold">Explore</a>
          </div>
        </div>
      </div>
    }
  </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
