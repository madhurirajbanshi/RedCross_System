@model RedCross_System.ViewModel.Register.RegisterViewModel

@{
  ViewData["Title"] = "Register";
}

@{
  Layout = null;
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

<div class="login-container">
  <div class="header-illustration">
    
    <div class="system-name">
      <span>
        <img src="~/uploads/RedCrossLogo.png" alt="RedCrossSystem Logo" class="brand-image img-circle elevation-3"
             style="opacity: .8">
      </span>Red Cross System
    </div>
  </div>

  <form asp-action="Index" method="post" class="login-form">
    @if (!ViewData.ModelState.IsValid || ViewData["Error"] != null)
    {
      <div class="alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
          <p>@error.ErrorMessage</p>
        }

      </div>
    }

    <div class="form-group">
        <div class="form-group">
          <i class="fas fa-user"></i>
          <input asp-for="UserName" class="form-control" placeholder="username" />
          <span asp-validation-for="UserName" class="text-danger"></span>


    </div>

    <div class="form-group">
          <i class="fas fa-envelope"></i>
          <input asp-for="Email" type="email" class="form-control" placeholder="Email"/>
          <span asp-validation-for="Email" class="text-danger"></span>
    </div>
        <div class="form-group">
          <i class="fas fa-phone"></i>
          <input asp-for="Phone" class="form-control"  placeholder="Phone"/>
          <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="form-group">
          <i class="fas fa-lock"></i>
          <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
          <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="form-group">
          <i class="fas fa-lock"></i>
          <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="ConfirmPassword" />
          <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="form-group">
          @Html.DropDownListFor(model => model.RoleId, new SelectList(Model.Roles, "Value", "Text"), "-- Select Role --", new { @class = "form-control" })
        </div>

      <div class="form-group">
        @Html.DropDownListFor(model => model.BloodTypeId, new SelectList(Model.BloodTypes, "Value", "Text"), "-- Select BloodType --", new { @class = "form-control" })
      </div>

      <div class="button-container">
        <a href="@Url.Action("Index", "Login")" class="login-btn">Login</a>
        <button type="submit" class="login-btn">Signup</button>
      </div>


      


        </div>

      </form>
    </div>


  
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<style>
  * {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
}

body {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  padding: 20px;
}

.login-container {
  background: white;
  width: 100%;
  max-width: 400px;
  border-radius: 12px;
  padding: 30px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
}

.header-illustration {
  text-align: center;
  margin-bottom: 30px;
}

.redcross-logo {
  color: #E31837;
  font-size: 48px;
  margin-bottom: 10px;
}

.system-name {
  color: #E31837;
  font-size: 24px;
  font-weight: 600;
  margin-top: 10px;
}

.login-title {
  color: #495057;
  font-size: 18px;
  margin-top: 10px;
  text-align: center;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-top: 20px;
}

.form-group {
  position: relative;
}

.form-group input {
  width: 100%;
  padding: 14px 45px 14px 16px;
  border: 2px solid #dee2e6;
  border-radius: 8px;
  font-size: 16px;
  transition: all 0.3s ease;
}

.form-group input:focus {
  border-color: #E31837;
  outline: none;
  box-shadow: 0 0 0 3px rgba(227, 24, 55, 0.1);
}

.form-group i {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: #adb5bd;
}

.remember-me {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #495057;
  font-size: 14px;
}

.login-button {
  background: #E31837;
  color: white;
