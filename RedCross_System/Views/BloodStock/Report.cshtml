@model  List<RedCross_System.ViewModel.TestBlood.TestBloodReportViewModel>
@{
  ViewData["Title"] = "Blood Stock Report";
}

<h2>Blood Stock Report</h2>

<table class="table table-bordered">
  <thead>
    <tr>
      <th>Donor Name</th>
      <th>Campaign Name</th>
      <th>Branch</th>
      <th>Donation Date</th>
      <th>Expiry Date</th>
      <th>Quantity</th>
      <th>Blood Type</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    @foreach (var item in Model)
    {
      <tr>
        <td>@item.DonorName</td>
        <td>@item.BranchName</td>
        <td>@item.DonationDate.ToString("yyyy-MM-dd")</td>
        <td>@item.Quantity</td>
        <td>@item.BloodType</td>
        <td>@item.Status</td>
      </tr>
    }
  </tbody>
</table>
