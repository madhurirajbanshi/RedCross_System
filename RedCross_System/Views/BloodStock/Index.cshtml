@model RedCross_System.ViewModel.BloodStock.BloodStockAddViewModel

<div class="text-center ">
  <h3 class="display-2">Blood Donation View</h3>
</div>

<div class="card custom-card mb-4 shadow-sm">
  <div class="card-header bg-primary text-white text-left">
    <h3 class="h6 mb-0">
      <i class="bi bi-people-fill"></i> Campaign Donors
    </h3>
  </div>
  <div class="card-body">
    @if (Model.CampaignDonors?.Count > 0)
    {
      <ol class="list-group list-group-numbered">
        @for (int i = 0; i < Model.CampaignDonors.Count; i++)
        {
          <li class="list-group-item">
            <span class="fw-bold">@Model.CampaignDonors[i].Name</span>
          </li>
        }
      </ol>
    }
    else
    {
      <p class="text-muted text-center">No campaign donors available.</p>
    }
  </div>
</div>

<div class="card custom-card shadow-sm">
  <div class="card-header bg-success text-white text-left">
    <h3 class="h6 mb-0">
      <i class="bi bi-person-heart"></i> Non-Campaign Donors
    </h3>
  </div>
  <div class="card-body">
    @if (Model.NonCampaignDonors?.Count > 0)
    {
      <ol class="list-group list-group-numbered">
        @for (int i = 0; i < Model.NonCampaignDonors.Count; i++)
        {
          <li class="list-group-item">
            <span class="fw-bold">@Model.NonCampaignDonors[i].Name</span>
          </li>
        }
      </ol>
    }
    else
    {
      <p class="text-muted text-center">No non-campaign donors available.</p>
    }
  </div>
</div>
<style>
  .custom-card {
    width: 60%; /* Adjust width to 60% or any percentage that fits your design */
    margin: 0 auto;
  }

  h1.display-2 {
    font-family: 'Arial', sans-serif;
    font-weight: bold;
    color: #4B4B4B;
    text-transform: uppercase;
  }

  .card-header i {
    margin-right: 8px; /* Adds space between the icon and the text */
  }

  .bg-primary i {
    color: white;
  }

  .bg-success i {
    color: white;
  }
</style>


<!-- Add Bootstrap CSS and Icon Library -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
