@model RedCross_System.ViewModel.Donor.DonorAddViewModel

<div>

  <h1 style="text-align:center">Donor</h1>
  <form method="post" asp-action="Add" enctype="multipart/form-data">
    <div class="mb-2">

      <label for="" class="form-label">Name</label>
      <input type="text" class="form-control" asp-for="Name" />
    </div>
    <div class="mb-2">
      <label for="" class="form-label">Temporary Address</label>
      <input type="text" class="form-control" asp-for="TemporaryAddress" />
    </div>
    <div class="mb-2">
      <label for="" class="form-label">Permanent Address</label>
      <input type="text" class="form-control" asp-for="PermanentAddress" />
    </div>

    <div class="mb-2">
      <label for="" class="form-label">Email</label>
      <input type="email" class="form-control" asp-for="Email" />
    </div>

   
    <div class="mb-2">
      <label for="MobileNumber" class="form-label">Mobile Number</label>
      <input type="text" class="form-control" asp-for="MobileNumber" />
    </div>
    <div class="mb-2">
      <label for="SecondaryNumber" class="form-label">Secondary Number</label>
      <input type="text" class="form-control" asp-for="SecondaryNumber" />
    </div>

    <div class="form-group">
      <label for="File">Upload Photo</label>
      <input asp-for="File" class="form-control" type="file" />
      <span asp-validation-for="File" class="text-danger"></span>
    </div>

    <div class="mb-2">
      <label for="BloodType" class="form-label">Blood Type</label>
      <select class="form-control" asp-for="BloodType" asp-items="@Model.BloodTypes">
        <option value="">-- Select BloodType --</option>

      </select>
    </div>
    <div class="text-center">
      <button type="submit" class="btn btn-primary">Submit</button>
    </div>
  </form>

  <style>
    form {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      background-color: #f9f9f9;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

      form h1 {
        text-align: center;
        margin-bottom: 20px;
        font-size: 24px;
        color: #333;
      }

    label.form-label {
      font-weight: 600;
      color: #555;
      margin-bottom: 8px;
      display: block;
    }

    input.form-control {
      width: 100%;
      padding: 10px;
      margin: 8px 0;
      border: 1px solid #ccc;
      border-radius: 4px;
      box-sizing: border-box;
    }

      input.form-control:focus {
        outline: none;
        border-color: #007bff;
        box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
      }

    button.btn {
      background-color: green;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 4px;
      font-size: 16px;
      cursor: pointer;
      transition: background-color 0.3s;
      display: flex;
      justify-content: center;
      align-items: center;
    }

      button.btn:hover {
        background-color: #0056b3;
      }

    .mb-2 {
      margin-bottom: 1rem;
    }

    input[type="file"] {
      padding: 5px;
      margin-top: 8px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }

      input[type="file"]:focus {
        border-color: #007bff;
        box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
      }

    .text-center {
      text-align: center;
      .text-center

    {
      text-align: center;
    }

    button.btn {
      display: block;
      margin: 0 auto;
    }

    }
  </style>
</div>

