@model List<RedCross_System.ViewModel.Donor.DonorIndexViewModel>

<div class="container mt-4">
  <h1 class="text-left text-primary mb-4">Donor Records</h1>
  <div class="d-flex justify-content-start mb-3">
    <a asp-action="Add" asp-controller="Donor" class="btn btn-primary" style="text-decoration: none;">
      <i class="fas fa-plus"></i> Add Donor
    </a>
  </div>


  <div class="card card-primary">
    <div class="card-header">
      <h3 class="card-title">Donor Information</h3>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-bordered table-hover table-striped">
          <thead class="thead-light">
            <tr>
              <th class="text-nowrap">SN</th>
              <th class="text-nowrap">Donor Name</th>
              <th class="text-nowrap">Temporary Address</th>
              <th class="text-nowrap">Permanent Address</th>
              <th class="text-nowrap">Mobile Number</th>
              <th class="text-nowrap">Secondary Number</th>
              <th class="text-nowrap">Email</th>
              <th class="text-nowrap">Photo</th>
              <th class="text-nowrap">Blood Type</th>
              <th class="text-nowrap">Status</th>

              <th class="text-nowrap">Action</th>


            </tr>
          </thead>
          <tbody>
            @{
              long sn = 1;
              foreach (var donor in Model)
              {
                <tr>
                  <td>@sn</td>
                  <td>@donor.Name</td>
                  <td>@donor.TemporaryAddress</td>
                  <td>@donor.PermanentAddress</td>
                  <td>@donor.MobileNumber</td>
                  <td>@donor.SecondaryNumber</td>
                  <td>@donor.Email</td>
                  <td>
                    @if (!string.IsNullOrEmpty(@donor.Photo))
                    {
                      <img src="@donor.Photo" alt="Document" style="width: 100px; height: auto;" />
                    }
                    else
                    {
                      <span>No Photo</span>
                    }
                  </td>
                  <td>@donor.BloodType</td>

                  <td>
                    <span class="badge @(donor.Status == "Active" ? "bg-success" : "bg-danger")">
                      @donor.Status
                    </span>
                  </td>
                  <td>
                    <div class="d-flex justify-content-center">
                      <a asp-action="Update" asp-route-id="@donor.Id" class="btn btn-success btn-sm">
                        <i class="fas fa-edit"></i> Update
                      </a>
                      <a asp-action="ViewProfile" asp-route-id="@donor.Id" class="btn btn-info btn-sm">
                        <i class="fas fa-eye"></i> View Profile
                      </a>
                      <form asp-action="ToggleStatus" asp-route-id="@donor.Id" method="post">
                        <button type="submit" class="btn btn-status @(donor.Status == "Active" ? "btn-danger" : "btn-success")">
                          @(donor.Status == "Active" ? "Deactivate" : "Activate")
                        </button>
                      </form>

                    </div>
                  </td>
                </tr>
                sn++;
              }
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<style>
  /* Table Styling */
  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table {
    width: 100%;
    margin-bottom: 0;
    white-space: nowrap;
  }

    .table th,
    .table td {
      text-align: center;
      vertical-align: middle;
      padding: 0.75rem;
      min-width: 100px;
    }

  /* Button Styling */
  .btn-sm {
    padding: 6px 12px;
    font-size: 14px;
    white-space: nowrap;
  }

  .btn-success {
    background-color: #28a745;
    border-color: #28a745;
  }

    .btn-success:hover {
      background-color: #218838;
      border-color: #1e7e34;
    }

  /* Card Header Styling */
  .card-header {
    background-color: #003366;
    color: white;
    padding: 1rem;
  }

  .card-body {
    padding: 20px;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: bold;
    margin: 0;
  }

  /* Flexbox for action buttons */
  .d-flex {
    display: flex;
    gap: 10px;
  }

  /* Container spacing */
  .container {
    padding-top: 20px;
    max-width: 100%;
  }
</style>